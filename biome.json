{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/test-results",
      "!**/playwright-report",
      "!bench/.bench-fixture.json",
      "!package-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "overrides": [{ "includes": ["client/src/styles/tailwind.css"], "linter": { "rules": { "suspicious": { "noUnknownAtRules": "off" } } } }],
  "javascript": {
    "formatter": { "quoteStyle": "single", "trailingCommas": "none", "semicolons": "always" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "off" },
      "style": { "noNonNullAssertion": "off", "useImportType": "warn" },
      "a11y": { "useSemanticElements": "warn" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } }
}
