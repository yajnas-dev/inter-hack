PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/job_portal?replicaSet=rs0
MONGO_URI_TEST=mongodb://127.0.0.1:27017/job_portal_test?replicaSet=rs0

# Required in production (16+ characters). The development default is refused when NODE_ENV=production.
JWT_SECRET=change_this_to_a_long_random_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Set true when served over HTTPS so the refresh cookie is Secure.
COOKIE_SECURE=false

CLIENT_URL=http://localhost:5173
# WEB_CONCURRENCY=4   # production defaults to one worker per CPU core
# LOG_LEVEL=info
# ENABLE_METRICS=true
# ENABLE_DOCS=true
