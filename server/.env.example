PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/job_portal?replicaSet=rs0
MONGO_URI_TEST=mongodb://127.0.0.1:27017/job_portal_test?replicaSet=rs0

# ---- auth ----------------------------------------------------------------------------------------
# Required in production: a random value of at least 32 characters (the development default is refused).
JWT_SECRET=change_this_to_a_long_random_secret
# JWT_ISSUER=job-portal-api
# JWT_AUDIENCE=job-portal-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# BCRYPT_ROUNDS=12
# Refresh cookie is Secure by default in production; set false only for plain-http local runs.
# COOKIE_SECURE=false

# ---- HTTP ----------------------------------------------------------------------------------------
# Browser origins allowed by CORS (comma-separated).
CLIENT_URL=http://localhost:5173
# Number of reverse proxies in front of the API (0/false when clients connect directly). Trusting
# X-Forwarded-For when there is no proxy lets clients spoof their IP and dodge rate limits.
TRUST_PROXY=false
# RATE_LIMIT_PER_MIN=300
# AUTH_RATE_LIMIT=20
# AI_RATE_LIMIT_PER_HOUR=30

# ---- AI match analysis (optional) --------------------------------------------------------------
# Server-side only. Without a key the match endpoints return a rule-based estimate (engine: "heuristic").
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
# AI_TIMEOUT_MS=45000

# ---- operations ------------------------------------------------------------------------------------
# WEB_CONCURRENCY=4   # production defaults to one worker per CPU core
# LOG_LEVEL=info
# ENABLE_METRICS=true
# ENABLE_DOCS=true
